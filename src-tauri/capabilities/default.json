{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SnapCap minimal capabilities: core IPC, windows, dialog, autostart, global shortcut, updater and logging. Clipboard stays in Rust (arboard), so no clipboard plugin is granted.",
  "windows": ["main", "overlay", "editor", "recorder"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-title",
    "dialog:default",
    "autostart:default",
    "global-shortcut:default",
    "updater:default",
    "log:default"
  ]
}
